# The `just` example of the method's entry points. `just` lists every recipe; CI runs these same
# recipes. Bodies are the binding's job: fill each with the tool docs/process/binding.md names. A
# gate the binding binds to `none` with a reason becomes `@echo "none: <reason>"` and exits 0.

set shell := ["bash", "-euo", "pipefail", "-c"]

# `just` never expands `~`, so the fallback is built from the home directory.
ratchet_plugin := env_var_or_default("RATCHET_PLUGIN", home_directory() / ".claude/plugins/marketplaces/ratchet")

# What the diff gates compare against: the remote default branch, else the local one when the
# repository has no remote.
merge_base := `git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || true`

default:
    @just --list --unsorted

# --- tiers -----------------------------------------------------------------

tier0: pre-commit commits

# Tier 0 less the history gate: what the pre-commit hook runs, since `commits` there would judge
# the commit an amend replaces. The commit-msg hook checks the new subject with `commit-msg`.
pre-commit: fmt-check lint types imports deadcode lint-workflows secrets flags pins limits markers prose snapshots-check ratchet-lowered suppressions

tier1: test coverage diff-coverage test-counts mutation-changed contracts-check audit duplication build smoke telemetry flag-states load-smoke bite api-check data-compat doctests sast iac artefact-scan type-coverage doc-coverage change-size guard-diff settings-check conformance

tier2: mutation api-deep symbolic fuzz e2e test-stability reproducible sanitizers perf dast pentest load telemetry-e2e flags-expired a11y formal

check: tier0 tier1

check-deep: check tier2

# --- method gates (tool-neutral, shipped by the ratchet plugin) --------------

ratchet-lowered:
    python3 "{{ratchet_plugin}}/scripts/lowered.py"

guard-diff:
    PYTHONPATH="{{ratchet_plugin}}/hooks" python3 -m ratchet_guards.diff --root . || true

# The permission rules in .claude/settings.json mirror guards/manifest.toml: one Edit rule per
# pattern, deny for a locked group, plus the fixed command rules. `just settings` regenerates them.
settings-check:
    python3 "{{ratchet_plugin}}/scripts/settings_rules.py" --check

settings:
    python3 "{{ratchet_plugin}}/scripts/settings_rules.py" --write

conformance:
    python3 "{{ratchet_plugin}}/scripts/conformance.py" .

# Time one tier or gate against its ceiling in quality/thresholds.toml; `just budget tier1 --set`
# records the first ceiling. CI wraps every matrix job in it and uploads the report.
budget key *flags:
    python3 "{{ratchet_plugin}}/scripts/budget.py" {{key}} --report .ratchet/timing.jsonl {{flags}} -- just {{key}}

# --- ratchet maintenance ------------------------------------------------------

# Raise every threshold to its measured value and refresh the snapshots.
ratchet:
    @echo "bind: run the suites with a Cobertura report at coverage.xml, then the mutation run"; exit 1
    python3 "{{ratchet_plugin}}/scripts/coverage_groups.py" --report coverage.xml --write
    just snapshots

# The files of the manifest's tool-config group, copied into quality/snapshots/ (a ratchet path).
snapshots:
    python3 "{{ratchet_plugin}}/scripts/snapshots.py" --write

snapshots-check:
    python3 "{{ratchet_plugin}}/scripts/snapshots.py" --check

suppressions:
    python3 "{{ratchet_plugin}}/scripts/suppressions.py"

# The flag registry: declared, owned, off when new. `flags-expired` asks the calendar, in tier 2.
# Add `--used-in <source dir>` once the stack is bound, so a flag leaves the registry with its code.
flags:
    python3 "{{ratchet_plugin}}/scripts/flags.py"

flags-expired:
    python3 "{{ratchet_plugin}}/scripts/flags.py" --expired

commits:
    python3 "{{ratchet_plugin}}/scripts/commits.py"

commit-msg file:
    python3 "{{ratchet_plugin}}/scripts/commits.py" --message-file "{{file}}"

# --- tier 0 bodies ---------------------------------------------------------------

fmt-check:
    @echo "bind: formatter --check"; exit 1

lint:
    @echo "bind: linter with near-all rules"; exit 1

types:
    @echo "bind: strict type checker"; exit 1

imports:
    @echo "bind: dependency-direction tool"; exit 1

deadcode:
    @echo "bind: dead code and dependency hygiene"; exit 1

lint-workflows:
    @echo "bind: shell and CI workflow linters"; exit 1

secrets:
    @echo "bind: secret scanner over the tree"; exit 1

pins:
    python3 "{{ratchet_plugin}}/scripts/pins.py"
    @echo "bind: lockfile matches manifest, no floating range (the stack's lock --check)"; exit 1

limits:
    @echo "bind: size and complexity rules plus the fitness test, numbers from the binding's Limits"; exit 1

markers:
    python3 "{{ratchet_plugin}}/scripts/markers.py"

prose:
    python3 "{{ratchet_plugin}}/scripts/prose.py"

# --- tier 1 bodies ---------------------------------------------------------------

test:
    @echo "bind: unit, property and fitness tests"; exit 1

coverage:
    @echo "bind: run the suite with a Cobertura report at coverage.xml"; exit 1
    python3 "{{ratchet_plugin}}/scripts/coverage_groups.py" --report coverage.xml

diff-coverage:
    @echo "bind: every changed line and branch ran"; exit 1

test-counts:
    @echo "bind: collected test count at head >= merge base"; exit 1

mutation-changed:
    @echo "bind: mutate changed functions; zero unregistered survivors"; exit 1

contracts-check:
    @echo "bind: regenerate contract artefacts and diff"; exit 1

audit:
    @echo "bind: audit shipped dependencies"; exit 1

duplication:
    @echo "bind: clone detector with a ceiling"; exit 1

build:
    @echo "bind: build the deliverable"; exit 1

smoke:
    @echo "bind: start the deliverable, hit its health probe, stop it"; exit 1

telemetry:
    @echo "bind: the telemetry tests against an in-memory exporter; red when there are none"; exit 1

# `flags.py --changed` prints one key per line; no changed flag means no extra run.
flag-states:
    @echo "bind: for each key of flags.py --changed, the suite with the flag forced off, then on"; exit 1

load-smoke:
    @echo "bind: seconds of concurrent requests at the booted deliverable; any error fails"; exit 1

bite:
    python3 "{{ratchet_plugin}}/scripts/bite.py"
    @echo "bind: run every project fitness test and gate tool against its synthetic violation"; exit 1

api-check:
    @echo "bind: snapshot the public surface and diff; a change needs a version bump or changelog line"; exit 1

data-compat:
    @echo "bind: load golden fixtures from earlier versions; apply and reverse migrations"; exit 1

doctests:
    @echo "bind: run the documentation's examples"; exit 1

sast:
    @echo "bind: static security analysis with the stack's rule set"; exit 1

iac:
    @echo "bind: configuration scanner over the Dockerfile, manifests and infrastructure code"; exit 1

artefact-scan:
    @echo "bind: scan the shipped artefact or base image for known vulnerabilities"; exit 1

type-coverage:
    @echo "bind: type coverage >= quality/thresholds.toml"; exit 1

doc-coverage:
    @echo "bind: documentation coverage of the public surface >= quality/thresholds.toml"; exit 1

change-size:
    python3 "{{ratchet_plugin}}/scripts/change_size.py"

# --- tier 2 bodies ---------------------------------------------------------------

mutation:
    @echo "bind: full mutation run over absolute layers"; exit 1

api-deep:
    @echo "bind: deep and stateful interface conformance"; exit 1

symbolic:
    @echo "bind: symbolic checker over contracts"; exit 1

fuzz seconds="600":
    @echo "bind: fuzz for {{seconds}} seconds"; exit 1

e2e:
    @echo "bind: end-to-end suite"; exit 1

test-stability:
    @echo "bind: run the suite shuffled and repeated with fresh seeds"; exit 1

reproducible:
    @echo "bind: build twice and compare hashes"; exit 1

sanitizers:
    @echo "bind: race detector and sanitizers where the stack has them"; exit 1

perf:
    @echo "bind: benchmarks against the binding's performance ceilings"; exit 1

dast:
    @echo "bind: dynamic security scan against the end-to-end environment"; exit 1

pentest:
    @echo "bind: active scan with a session, and contract-driven attacks on every route"; exit 1

load:
    @echo "bind: load test against the end-to-end environment, thresholds from the binding's Limits"; exit 1

telemetry-e2e:
    @echo "bind: read a request's trace, metrics and logs back from the collector"; exit 1

a11y:
    @echo "bind: accessibility checks inside the end-to-end suite"; exit 1

formal:
    @echo "bind: run the project-local formal verification skill's command"; exit 1

# --- outside the tiers ------------------------------------------------------------

audit-all:
    @echo "bind: audit every dependency, dev tooling included"; exit 1

licenses:
    @echo "bind: licence compatibility of shipped dependencies"; exit 1

drift:
    @echo "bind: outdated dependencies and the software bill of materials; advisory"; exit 1

load-soak:
    @echo "bind: hold the load for an hour, then raise it to the breaking point; advisory"; exit 1

reports:
    @echo "bind: hotspots, coupling, complexity; advisory only"; exit 1
