[no-exit-message]
_plugin:
    @if [ -n "${RATCHET_PYC_NOTE:-}" ]; then printf '%s\n' "$RATCHET_PYC_NOTE" >&2; fi; if [ -n "${RATCHET_PLUGIN_REFUSAL:-}" ]; then printf '%s\n' "$RATCHET_PLUGIN_REFUSAL"; exit 1; fi; if [ -z "${RATCHET_PLUGIN_DIR:-}" ]; then echo "no plugin recorded for this repository: start an agent session here once, or set RATCHET_PLUGIN to the plugin's folder"; exit 1; fi

