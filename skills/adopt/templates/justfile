set shell := ["bash", "-euo", "pipefail", "-c"]

plugin_choice := ```
    want=$(sed -n 's/^- Ratchet plugin: [^ ]* at [0-9a-f]\{40\} tree \([0-9a-f]\{40\}\)[ \t\r]*$/\1/p' docs/process/binding.md 2>/dev/null | head -n 1 || true)
    checked=${RATCHET_PLUGIN_CHECKED:-}
    rec=${RATCHET_PLUGIN:-}; file=0
    if [ -n "$want" ] && [ "${checked:0:41}" = "D$want" ] && [ "${checked:41:1}" = " " ]; then rec=${checked:42}
    elif [ -z "$rec" ]; then common=$(git rev-parse --git-common-dir 2>/dev/null) && rec=$(cat "$common/ratchet-plugin" 2>/dev/null) || rec=; file=1; fi
    [ -n "$rec" ] || exit 0
    rec=${rec%/}
    treeof() {
      python3 -I - "$1" 2>/dev/null <<-'PY'
	import hashlib, os, stat, sys
	def h(kind, body): return hashlib.sha1(b"%s %d\0" % (kind, len(body)) + body).digest()
	def walk(folder, rel):
	    out = []
	    for name in os.listdir(folder):
	        path = rel + name
	        if path in (".git", ".claude-plugin/commit", ".in_use", ".orphaned_at") or name == "__pycache__": continue
	        full = os.path.join(folder, name); mode = os.lstat(full).st_mode; raw = os.fsencode(name)
	        if stat.S_ISLNK(mode): out.append((raw, b"120000", h(b"blob", os.fsencode(os.readlink(full)))))
	        elif stat.S_ISDIR(mode):
	            sub = walk(full, path + "/")
	            if sub: out.append((raw + b"/", b"40000", sub))
	        elif stat.S_ISREG(mode):
	            with open(full, "rb") as handle: out.append((raw, b"100755" if mode & stat.S_IXUSR else b"100644", h(b"blob", handle.read())))
	    return h(b"tree", b"".join(kind + b" " + raw.rstrip(b"/") + b"\0" + digest for raw, kind, digest in sorted(out))) if out else None
	print((walk(sys.argv[1], "") or h(b"tree", b"")).hex())
	PY
    }
    if [ -z "$want" ]; then printf 'Rdocs/process/binding.md pins no tree id, so the plugin at %s cannot be checked: upgrade this project with `python3 %s/scripts/upgrade.py --apply`' "$rec" "$rec"; exit 0; fi
    have=$(treeof "$rec") || have=
    if [ "$have" = "$want" ]; then printf 'D%s %s' "$want" "$rec"; exit 0; fi
    if [ "$file" = 1 ]; then
      for sibling in "${rec%/*}"/*/; do
        sibling=${sibling%/}
        [ "$sibling" != "$rec" ] && [ -f "$sibling/.claude-plugin/plugin.json" ] && [ "$(treeof "$sibling" || true)" = "$want" ] && { printf 'D%s %s' "$want" "$sibling"; exit 0; }
      done
    fi
    if [ ! -d "$rec" ]; then printf 'Rthe plugin at %s is gone, and no copy on disk has the tree %s that docs/process/binding.md pins: install the plugin release the pin names, then start an agent session here once, or set RATCHET_PLUGIN to its folder' "$rec" "$want"; exit 0; fi
    printf 'Rthe plugin at %s is tree %s, not the %s that docs/process/binding.md pins, and no copy on disk matches: upgrade this project with `python3 %s/scripts/upgrade.py --apply`, or install the plugin release the pin names' "$rec" "${have:-unreadable}" "$want" "$rec"
```
plugin_tree := replace_regex(plugin_choice, '(?s)^R.*|^D([0-9a-f]{40}) .*', '$1')
plugin_pyc := ```
    d=${TMPDIR:-/tmp}/ratchet-pyc-$(id -u)
    mkdir -m 700 -- "$d" 2>/dev/null || true
    privately() {
      python3 -I - "$1" 2>/dev/null <<-'PY'
	import os, pwd, stat, sys
	try: found = os.lstat(sys.argv[1])
	except OSError: print("Rnot there and cannot be made"); sys.exit()
	if stat.S_ISLNK(found.st_mode): print("Ra link")
	elif not stat.S_ISDIR(found.st_mode): print("Rnot a folder")
	elif found.st_uid != os.getuid():
	    try: owner = pwd.getpwuid(found.st_uid).pw_name
	    except KeyError: owner = str(found.st_uid)
	    print("Rowned by " + owner)
	elif found.st_mode & 0o022: print("Rmode %o" % stat.S_IMODE(found.st_mode))
	else: print("O")
	PY
    }
    verdict=$(privately "$d") || verdict=
    if [ "$verdict" = O ]; then printf 'O%s' "$d"; exit 0; fi
    case "$verdict" in R?*) why=${verdict#R} ;; *) why="not checked, since the check did not answer" ;; esac
    printf 'Rplugin: compiled files are not cached, since %s is %s, so every plugin script compiles from source on each start; remove %s and the next run makes a private one' "$d" "$why" "$d"
```
plugin_pyc_ok := if plugin_tree == "" { "" } else { replace_regex(plugin_pyc, '(?s)^R.*|^O', '') }
pyc_said := env_var_or_default("RATCHET_PYC_SAID", "")
export RATCHET_PYC_SAID := "1"
export RATCHET_PYC_NOTE := if plugin_tree == "" { "" } else if pyc_said != "" { "" } else { replace_regex(plugin_pyc, '(?s)^O.*|^R', '') }
plugin_py := if plugin_pyc_ok == "" { "python3 -E -s -B -X pycache_prefix=/nonexistent/ratchet-no-bytecode" } else { "python3 -E -s -X " + quote("pycache_prefix=" + plugin_pyc_ok + "/" + plugin_tree) }
export RATCHET_PLUGIN_DIR := replace_regex(plugin_choice, '(?s)^R.*|^D[0-9a-f]{40} ', '')
export RATCHET_PLUGIN_REFUSAL := replace_regex(plugin_choice, '(?s)^D.*|^R', '')
export RATCHET_PLUGIN_CHECKED := replace_regex(plugin_choice, '(?s)^R.*', '')
ratchet_plugin := "$RATCHET_PLUGIN_DIR"
export RATCHET_RUN := env_var_or_default("RATCHET_RUN", uuid())

boot := "bind: the command that builds and starts the deliverable in the foreground, such as ./server --host {host} --port {port}"
ready := "bind: the URL that answers once it is up, such as http://127.0.0.1:{port}/health"
boot_timeout := "30"
listens := "none"
service := "bind: the service.name every signal carries"
booted := plugin_py + ' "' + ratchet_plugin + '/scripts/with_service.py" --boot ' + quote(boot) + ' --ready ' + quote(ready) + ' --timeout ' + boot_timeout + if listens == "none" { "" } else { ' --listens ' + quote(listens) }

flags_on := "bind: NAME=VALUE, the flag seam's override with each key of flags.py --temporary on"
probed := booted + ' --env "' + flags_on + '"'

shard := env_var_or_default("SHARD", "1")
shards := env_var_or_default("SHARDS", "1")

mutation_incremental := if env_var_or_default("CI", "") + env_var_or_default("RATCHET_BITING", "") == "" { "bind: the mutation tool's option that reuses the last run's results" } else { "" }

port := "8000"

test_runner := "bind: the command that runs the test files named after it, or every test with none"

default:
    @just --list --unsorted

start *args:
    @{{ if ready =~ '^https?://' { "echo 'open " + replace(ready, "{port}", port) + " once it is up; Ctrl-C stops it'" } else { "true" } }}
    export PORT={{port}}; {{ replace(replace(boot, "{port}", port), "{host}", if ready =~ '^https?://' { lowercase(replace_regex(ready, '^[a-z]+://(?:[^/?#]*@)?(?:\[([^]]*)\]|([^/?#:]*)).*$', '${1}${2}')) } else { "{host}" }) }} {{args}}

test-files *files:
    {{test_runner}} {{files}}

tier0_tree_gates := "fmt-check lint types imports deadcode lint-workflows secrets flags pins limits markers prose snapshots-check ratchet-lowered suppressions comments"
tier0_gates := tier0_tree_gates + " commits"
tier1_gates := "test coverage diff-coverage test-counts tests-changed mutation-changed contracts-check audit duplication build smoke telemetry flag-states load-smoke bite api-check data-compat doctests sast iac artefact-scan type-coverage doc-coverage change-size guard-diff settings-check conformance triggers incidents rollback dependency-faults config-refusal graceful-stop"
tier2_gates := "mutation api-deep symbolic fuzz e2e test-stability reproducible sanitizers perf dast pentest load telemetry-e2e flags-expired a11y formal bite-all"

tier1_sharded := "test mutation-changed"
tier2_sharded := "mutation e2e test-stability"

serial0 := ""
serial1 := "--serial coverage mutation-changed"
serial2 := ""

configured_jobs := `git config --get ratchet.jobs 2>/dev/null || true`
jobs := env_var_or_default("RATCHET_JOBS", if configured_jobs == "" { num_cpus() } else { configured_jobs })

alone := "--alone perf load mutation test-stability"

parallel := plugin_py + ' "' + ratchet_plugin + '/scripts/parallel.py" --runner "' + just_executable() + '" --report .ratchet/timing.jsonl --jobs ' + jobs + ' ' + alone

changed := plugin_py + ' "' + ratchet_plugin + '/scripts/changed.py"'

install:
    @true

dependencies dir:
