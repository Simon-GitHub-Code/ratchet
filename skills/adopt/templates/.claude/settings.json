{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/workflows/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Edit(/.git/refs)",
      "Edit(/.git/refs/**)",
      "Edit(/.git/packed-refs)",
      "Edit(/.git/HEAD)",
      "Edit(/.git/info/grafts)",
      "Edit(/.git/shallow)",
      "Edit(/.git/objects/info)",
      "Edit(/.git/objects/info/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/plugins/**)",
      "Bash(git push --force:*)",
      "Bash(git push * --force*)",
      "Bash(git push -f:*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --no-verify:*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit * --no-verify*)",
      "Bash(pre-commit uninstall:*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh repo edit:*)",
      "Bash(gh label edit:*)",
      "Bash(gh label delete:*)",
      "Bash(gh label clone:*)",
      "Bash(gh run delete:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git branch -f main:*)",
      "Bash(git branch -d main:*)",
      "Bash(git branch -D main:*)",
      "Bash(git branch -m main:*)",
      "Bash(git branch -M main:*)",
      "Bash(git branch -f master:*)",
      "Bash(git branch -d master:*)",
      "Bash(git branch -D master:*)",
      "Bash(git branch -m master:*)",
      "Bash(git branch -M master:*)",
      "Bash(git update-ref refs/heads/main:*)",
      "Bash(git update-ref -d refs/heads/main:*)",
      "Bash(git update-ref refs/heads/master:*)",
      "Bash(git update-ref -d refs/heads/master:*)",
      "Bash(git checkout -B main:*)",
      "Bash(git switch -C main:*)",
      "Bash(git checkout -B master:*)",
      "Bash(git switch -C master:*)",
      "Bash(git update-ref refs/remotes/*)",
      "Bash(git replace:*)",
      "Bash(git fast-import:*)",
      "Bash(git send-pack:*)",
      "Bash(git receive-pack:*)",
      "Bash(git remote add origin:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote set-head:*)",
      "Bash(git remote set-branches:*)",
      "Bash(git remote rename:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rm:*)"
    ],
    "ask": []
  }
}
