# python-uv preset: recipe bodies adopt merges into the template justfile. Every recipe here
# replaces the template recipe of the same name. Tools run through `uv run` so the lockfile pins
# them; `uv sync --group dev` installs them once.

# --- tier 0 bodies ---------------------------------------------------------------

fmt-check:
    uv run ruff format --check .

lint:
    uv run ruff check .

types:
    uv run mypy --strict .

imports:
    uv run lint-imports

deadcode:
    uv run vulture src tests --min-confidence 80
    uv run deptry .

lint-workflows:
    uvx actionlint
    git ls-files -z '*.sh' | xargs -0 -r shellcheck

secrets:
    uvx gitleaks git --no-banner --redact .

pins:
    python3 "{{ratchet_plugin}}/scripts/pins.py"
    uv lock --check

# Size and complexity are ruff rules (C901, PLR09xx) with the numbers from the binding's Limits;
# the fitness test checks the numbers are the ones the binding names.
limits:
    uv run ruff check --select C901,PLR0912,PLR0913,PLR0915,PLR0917 .
    uv run pytest -q tests/fitness -k limits

# --- tier 1 bodies ---------------------------------------------------------------

test:
    uv run pytest -q

coverage:
    uv run pytest -q --cov=src --cov-branch --cov-report=xml:coverage.xml
    python3 "{{ratchet_plugin}}/scripts/coverage_groups.py" --report coverage.xml

diff-coverage:
    uv run diff-cover coverage.xml --compare-branch="{{merge_base}}" --fail-under=100

test-counts:
    #!/usr/bin/env bash
    set -euo pipefail
    base="{{merge_base}}"
    # Why: addopts carries -q, and a second -q prints per-file counts with no node ids to count.
    now="$(uv run pytest --collect-only -q -o addopts= | grep -c '::' || true)"
    rm -rf .ratchet/base && git worktree add -q --detach .ratchet/base "$base"
    was="$(cd .ratchet/base && uv run pytest --collect-only -q -o addopts= | grep -c '::' || true)"
    git worktree remove --force .ratchet/base
    echo "tests: $was at base, $now at head"
    test "$now" -ge "$was"

# The score is a trend; the gate is the register: every live mutant killed or registered, no stale
# entry. `mutants/` is removed first because mutmut keeps a verdict until the function changes, so
# a new test never re-tests an old survivor from the cache. `mutmut run` takes mutant-name
# patterns; `--changed` prints one per changed source module, with `do_not_mutate` applied.
mutation-changed:
    #!/usr/bin/env bash
    set -euo pipefail
    mapfile -t scope < <(python3 "{{ratchet_plugin}}/scripts/mutation_survivors.py" --tool mutmut --changed)
    if [ "${#scope[@]}" -eq 0 ]; then echo "mutation-changed: no source module changed"; exit 0; fi
    rm -rf mutants
    uv run mutmut run "${scope[@]}"
    uv run mutmut results --all true | python3 "{{ratchet_plugin}}/scripts/mutation_survivors.py" --tool mutmut --results - --only "${scope[@]}"

contracts-check:
    @echo "none: no generated contract artefacts in this stack; see the binding's ADR"; exit 0

# The shipped dependencies only; `audit-all` audits the whole environment, dev tools included.
audit:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p .ratchet
    uv export --frozen --no-dev --no-emit-project --no-hashes --format requirements-txt > .ratchet/shipped.txt
    if ! grep -q '^[a-zA-Z]' .ratchet/shipped.txt; then echo "audit: no shipped dependency"; exit 0; fi
    uv run pip-audit --strict --disable-pip -r .ratchet/shipped.txt

duplication:
    uv run pylint --disable=all --enable=duplicate-code --min-similarity-lines=8 src

build:
    uv build

bite:
    python3 "{{ratchet_plugin}}/scripts/bite.py"
    uv run pytest -q tests/fitness -k bites

api-check:
    uv run griffe check "$(python3 -c 'import tomllib;print(tomllib.load(open("pyproject.toml","rb"))["project"]["name"].replace("-","_"))')" --against "{{merge_base}}"

doctests:
    uv run pytest -q --doctest-modules src

sast:
    uv run bandit -q -r src -c pyproject.toml

artefact-scan:
    uvx trivy fs --exit-code 1 --severity HIGH,CRITICAL .

type-coverage:
    @echo "none: mypy --strict leaves no untyped code to measure; see the binding's ADR"; exit 0

doc-coverage:
    uv run interrogate -q src --fail-under "$(python3 -c 'import tomllib;print(tomllib.load(open("quality/thresholds.toml","rb"))["python"]["docs"]["coverage"])')"

# --- tier 2 bodies ---------------------------------------------------------------

mutation:
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf mutants
    uv run mutmut run
    uv run mutmut results --all true | python3 "{{ratchet_plugin}}/scripts/mutation_survivors.py" --tool mutmut --results -

symbolic:
    uv run crosshair check src

fuzz seconds="600":
    HYPOTHESIS_PROFILE=fuzz FUZZ_SECONDS={{seconds}} uv run pytest -q -m fuzz

test-stability:
    uv run pytest -q -p randomly --count 3

reproducible:
    rm -rf dist && uv build && sha256sum dist/* > .ratchet/build-1.sha
    rm -rf dist && uv build && sha256sum dist/* > .ratchet/build-2.sha
    diff .ratchet/build-1.sha .ratchet/build-2.sha

sanitizers:
    @echo "none: pure Python has no race or memory detector to run; see the binding's ADR"; exit 0

perf:
    uv run pytest -q --benchmark-only --benchmark-compare-fail=mean:10%

# --- outside the tiers ------------------------------------------------------------

audit-all:
    uv run pip-audit --strict

licenses:
    uv run pip-licenses --fail-on "GPL-3.0-only;AGPL-3.0-only"

drift:
    uv tree --outdated
    uvx cyclonedx-py environment -o .ratchet/sbom.json

reports:
    uv run radon cc -s -a src
